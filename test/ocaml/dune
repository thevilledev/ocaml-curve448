; The test suites linked with the pure OCaml backend (curve448.ocaml).

(copy_files# ../test_{vectors,reference,properties,domains}.ml)

; The generated field kernels, tested directly at the extremes of their input
; bounds.

(copy_files# ../../lib/ocaml/fe448_kernels.ml)

(test
 (name test_kernels)
 (modules test_kernels fe448_kernels)
 (package curve448)
 (libraries alcotest zarith))

(tests
 (names test_vectors test_reference test_properties)
 (modules test_vectors test_reference test_properties)
 (package curve448)
 (libraries
  support
  curve448.ocaml
  curve448.for_testing
  alcotest
  qcheck-core
  qcheck-alcotest
  yojson
  zarith
  digestif
  kdf.hkdf
  mirage-crypto-ec
  mirage-crypto-rng
  mirage-crypto-rng.unix)
 (deps
  (source_tree ../../test-vectors))
 (action
  (setenv
   CURVE448_TEST_VECTORS
   ../../test-vectors
   (run %{test}))))

(executable
 (name test_domains)
 (modules test_domains)
 (libraries support curve448.ocaml mirage-crypto-rng mirage-crypto-rng.unix)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.0.0))))

(rule
 (alias runtest)
 (package curve448)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.0.0)))
 (action
  (run %{exe:test_domains.exe})))
